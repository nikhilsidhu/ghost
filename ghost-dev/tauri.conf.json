{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Ghost Dev",
  "version": "0.1.0",
  "identifier": "com.ghost.dev",
  "build": {
    "devUrl": "http://localhost:1420/launcher.html"
  },
  "app": {
    "windows": [
      {
        "title": "Ghost Dev",
        "width": 1100,
        "height": 780,
        "minWidth": 820,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#000000",
        "theme": "Dark",
        "create": false
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": ["../ghost-app/src-tauri/icons/icon.png"]
  }
}
