{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/.schema/capabilities.json",
  "identifier": "default",
  "description": "Default capabilities for Ghost",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered"
  ]
}
